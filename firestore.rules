rules_version = '2';

// Everything the browser can reach is listed here. The server uses the Admin
// SDK, which bypasses these rules entirely — so any collection the server owns
// is denied to clients outright rather than left implicitly open.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Launcher entries. Everyone signed in reads them; only an admin edits.
    match /apps/{appId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Brand name, tagline and logo appear on the sign-in screen, before there
    // is a user — so this one is world-readable by design.
    match /branding/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Written only by the server (LINE sign-in and syncMyAccount).
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Each user's own show/hide choices.
    match /userAppPrefs/{uid}/apps/{appId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Server-only: a LINE-id reverse lookup and one-time SSO tickets. A leaked
    // ticket is a full account handover, so clients never touch this.
    match /lineIndex/{lineUserId} {
      allow read, write: if false;
    }
    match /ssoTickets/{ticketHash} {
      allow read, write: if false;
    }

    // Admin-side AI translation setup. The public half carries the provider,
    // the model and a four-character hint of the key; the key itself sits in
    // /private, which no client may touch — the server functions write both.
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /private/{docId} {
      allow read, write: if false;
    }

    // Anything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
