# ---------------------------------------------------------------------------
# Copy to .env for local dev. On Netlify, set the same names under
# Site configuration -> Environment variables.
#
# VITE_* values are inlined at BUILD time — changing one needs a new build,
# not just a redeploy of the existing one.
# ---------------------------------------------------------------------------

# --- Firebase web config (public by design; Firebase console -> Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only. NEVER prefix these with VITE_ or they ship to the browser.

# The hub's own service account JSON, pasted as a single line.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Comma-separated. These accounts get the admin claim on sign-in, and lose it
# if removed from this list.
ADMIN_EMAILS=you@example.com

# --- LINE Login / LIFF
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=

# --- Child apps: one service account JSON per Firebase project, so the hub can
# mint a custom token that app can sign in with. Leave blank to skip an app —
# its SSO exchange then returns user data without a Firebase token.
FIREBASE_SA_TANTUN=
FIREBASE_SA_JAIKLAI=
FIREBASE_SA_HARMONY=
FIREBASE_SA_SONGMU=
FIREBASE_SA_YOUNGWAI=
